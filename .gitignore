# Benchmarks: only history.json and the scripts needed to run the suite and
# regenerate the README figure are tracked. Per-run result files, the local
# optimization worklog, and regenerable measurement/plot artifacts stay
# local (the canonical README figure lives in assets/).
benchmarks/results/
benchmarks/OPTIMIZATION_PLAN.md
benchmarks/visualization/.venv/
benchmarks/visualization/readme_bench
benchmarks/visualization/*.png
benchmarks/visualization/bench_results.json
benchmarks/visualization/plot_history.py

# Sampling profiles (scripts/profile.sh)
benchmarks/profiles/
build-profile/

# Local benchmark logs and visualization scratch (regenerable)
benchmarks/history.json
benchmarks/visualization/.venv/
benchmarks/visualization/readme_bench
benchmarks/visualization/bench_results.json
benchmarks/visualization/*.png
